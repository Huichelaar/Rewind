// Hooks to different consequences (events, but other things as well)
// that can happen/run as a result of actions.
// Idea is to store these in rewind buffer so they can be rewound.

PUSH

  // Unit loading.
    ORG 0xF770
      jumpToHack(REW_hookLoadUnit)
    ORG 0xFF42
      SHORT 0x0       // NOP
      jumpToHack(REW_hookEnun)
      SHORT 0x0       // NOP

  // Track item inventory changes.
  
    // Item obtained through loot drop or chest.
