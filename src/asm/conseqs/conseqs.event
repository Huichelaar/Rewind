      jumpToHack(REW_hookLootChestReceive2)
    ORG 0x1E1DC       // Inventory full, send obtained item to convoy.
      jumpToHack(REW_hookLootChestReceive3)
    ORG 0x1E2B2       // Inventory full, convoy full/unavailable. discard different item.
      SHORT 0x0       // NOP
      jumpToHack(REW_hookLootChestReceive4)
    */
  
    // Item obtained through drop/steal/chest.
  
      // - Inventory not full.
